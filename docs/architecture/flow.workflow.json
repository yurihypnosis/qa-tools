      "variant": "security",
      "role": "main",
      "fromSide": "bottom",
      "toSide": "left"
    },
    {
      "id": "checkvp-gate2",
      "from": "checkvp",
      "to": "gate2",
      "label": "修正は1回まで",
      "variant": "security",
      "role": "main",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "gate2-testcases",
      "from": "gate2",
      "to": "testcases",
      "label": "合図",
      "variant": "emphasis",
      "role": "main",
      "toSide": "top"
    },
    {
      "id": "testcases-review",
      "from": "testcases",
      "to": "review",
      "label": "続けて実行",
      "variant": "security",
      "role": "main",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "review-done",
      "from": "review",
      "to": "done",
      "label": "レシート",
      "variant": "default",
      "role": "main",
      "fromSide": "right",
      "toSide": "right"
    },
    {
      "id": "gate1-fix",
      "from": "gate1",
      "to": "analysis",
      "label": "修正指示 → 差分 Edit",
      "variant": "dashed",
      "role": "return",
      "fromSide": "bottom",
      "toSide": "right"
    },
    {
      "id": "gate2-fix",
      "from": "gate2",
      "to": "viewpoints",
      "label": "修正指示",
      "variant": "dashed",
      "role": "return",
      "fromSide": "left"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "ゲートの約束",
      "items": [
        "合図は「観点設計に進んでください」「ケース生成に進んでください」",
        "合図なしに次の工程を読み込まない・下書きしない",
        "[要確認] を推測で埋めない"
      ]
    },
    {
      "dot": "cyan",
      "title": "成果物",
      "items": [
        "すべて output/{ID}/ に 1-sizing.md〜5-review.md として保存",
        "修正は差分 Edit、同じゲートで再停止",
        "from: viewpoints などで途中の工程から再開"
      ]
    },
    {
      "dot": "emerald",
      "title": "セルフレビュー",
      "items": [
        "直すのはケースファイルだけ（観点は QA が確定済み）",
        "自己修正は 1 回まで、残った問題は報告"
      ]
    },
    {
      "dot": "amber",
      "title": "まだ実装していないもの",
      "items": [
        "USM 関連性分析・ナレッジの選別と承認",
        "PBI ナレッジ DB・各モード・英語出力"
      ]
    }
  ]
}
