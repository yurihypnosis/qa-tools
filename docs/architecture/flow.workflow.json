      "label": "観点",
      "fromCol": 3,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "cases",
      "label": "テストケース",
      "fromCol": 5,
      "toCol": 5
    }
  ],
  "mainPath": [
    "start",
    "sizing",
    "analysis",
    "gate1",
    "viewpoints",
    "checkvp",
    "gate2",
    "testcases",
    "review",
    "done"
