  "lanes": [
    {
      "id": "qa",
      "label": "QA エンジニア（人）"
    },
    {
      "id": "agent",
      "label": "Agent：test-case-generator skill"
    },
    {
      "id": "checks",
      "label": "セルフレビュー・決定的検査"
    }
