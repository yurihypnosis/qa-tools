      "variant": "security",
      "role": "main",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "gate2-step3",
      "from": "gate2",
      "to": "step3",
      "label": "合図",
      "variant": "emphasis",
      "role": "main",
      "toSide": "top"
    },
    {
      "id": "step3-checktc",
      "from": "step3",
      "to": "checktc",
      "label": "検査",
      "variant": "security",
      "role": "main",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "checktc-done",
      "from": "checktc",
      "to": "done",
      "label": "レシート",
      "variant": "default",
      "role": "main",
      "fromSide": "right",
      "toSide": "right"
    },
    {
      "id": "gate1-fix",
      "from": "gate1",
      "to": "step1",
      "label": "修正指示 → 差分 Edit",
      "variant": "dashed",
      "role": "return",
      "fromSide": "bottom",
      "toSide": "right"
    },
    {
      "id": "gate2-fix",
      "from": "gate2",
      "to": "step2",
      "label": "修正指示",
      "variant": "dashed",
      "role": "return",
      "fromSide": "left"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "ゲートの約束",
      "items": [
        "合図は「Step 2 の出力をしてください」「Step 3 の出力をしてください」",
        "合図なしに次の Step を読み込まない・下書きしない",
        "[要確認] を推測で埋めない"
      ]
    },
    {
      "dot": "cyan",
      "title": "成果物",
      "items": [
        "すべて output/{ID}/ に Markdown で保存",
        "修正は差分 Edit、同じゲートで再停止",
        "`from: step2` 指定 or 既存成果物から途中再開"
      ]
    },
    {
      "dot": "amber",
      "title": "MVP 外（後続）",
      "items": [
        "Step U / K / K-Gate / K-Evidence",
        "Step 0 サイジング",
        "Step R 自己レビュー・PBI ナレッジ"
      ]
    }
  ]
